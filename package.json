{
  "name": "agentguard",
  "version": "1.0.0",
  "private": true,
  "author": "Sumeet1249",
  "description": "High-integrity AI Agent auditing system",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:cockpit": "npm --workspace @agentguard/compliance-cockpit run dev",
    "dev:gateway": "npm --workspace @agentguard/gateway-mcp run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:banking": "jest --projects packages/core-schema packages/bank-gate packages/ledger-adapter packages/witness",
    "test:hackathon": "npm --workspace @agentguard/gateway-mcp test src/__tests__/hackathon-requirements.test.ts",
    "test:e2e": "node tools/e2e/smoke.mjs",
    "test:e2e:nobuild": "node tools/e2e/smoke.mjs --no-build",
    "test:isolation": "node tools/e2e/tenant-isolation.mjs",
    "test:isolation:nobuild": "node tools/e2e/tenant-isolation.mjs --no-build",
    "test:sdk-chaos": "python3 tools/e2e/sdk_chaos.py",
    "test:sdk-chaos:nobuild": "python3 tools/e2e/sdk_chaos.py --no-build",
    "loadtest": "node tools/loadtest/run.mjs",
    "lint": "turbo run lint",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy:marketing": "cd apps/marketing && npx wrangler deploy"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "optionalDependencies": {
    "web-tree-sitter": "^0.20.8"
  },
  "dependencies": {
    "@authenio/samlify-node-xmllint": "^2.0.0",
    "@esbuild/win32-x64": "^0.27.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-express": "^0.66.0",
    "@opentelemetry/instrumentation-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/sdk-trace-node": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "pg": "^8.21.0",
    "pg-mem": "^3.0.14",
    "samlify": "^2.13.1"
  }
}
